"FoodShareSystem" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8EEEA"><B>FoodShareSystem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ settings() : dict<BR/>+ daily_backup()<BR/>+ audit_log(...) : list<BR/>+ list_backups() : list<BR/>+ restore_backup(name)</TD></TR></TABLE>>];
"AuthService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8EEEA"><B>AuthService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ login(name, secret) : Session<BR/>+ touch(session)<BR/>+ is_expired(session) : bool</TD></TR></TABLE>>];
"UserService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8EEEA"><B>UserService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create_user(name, role, secret) : User<BR/>+ set_active(name, active)<BR/>+ list_users() : list</TD></TR></TABLE>>];
"StockService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8EEEA"><B>StockService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ record_donation(lines, ...) : Donation<BR/>+ record_offer(donor, items) : DonorOffer<BR/>+ stock_summary() : list<BR/>+ expiring_soon(days) : list<BR/>+ low_stock_alerts() : list<BR/>+ flag_batch(id, reason, note)</TD></TR></TABLE>>];
"ClientService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8EEEA"><B>ClientService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create_client(data) : Client<BR/>+ update_client(id, data) : Client<BR/>+ get_client(id) : Client<BR/>+ add_note(id, text, restricted)<BR/>+ information_summary(id) : str<BR/>+ delete_client(id)<BR/>+ retention_review() : list</TD></TR></TABLE>>];
"HamperService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8EEEA"><B>HamperService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ save_rules(rules) : list<BR/>+ book_pickup(client, date, slot) : Pickup<BR/>+ pickup_message(pickup) : dict<BR/>+ generate_hamper(code) : Hamper<BR/>+ adjust_line(id, line, qty, reason)<BR/>+ confirm_hamper(id, priority) : Task<BR/>+ confirm_collection(code) : dict<BR/>+ return_uncollected(id)<BR/>+ safe_substitutes(hamper, line) : list</TD></TR></TABLE>>];
"TaskService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8EEEA"><B>TaskService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create_task(kind, title, ...) : Task<BR/>+ my_tasks() : list<BR/>+ task_view(id) : dict<BR/>+ substitute_line(id, line, batch, note)<BR/>+ mark_line_unavailable(id, line)<BR/>+ complete_task(id) : Task<BR/>+ flag_issue(id, type, note)</TD></TR></TABLE>>];
"ReportService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8EEEA"><B>ReportService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ stock_movement(start, end) : dict<BR/>+ demand(start, end) : dict<BR/>+ to_csv(report) : str</TD></TR></TABLE>>];
"KioskService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8EEEA"><B>KioskService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ start(code, pin) : KioskSession<BR/>+ choose(session, field, value)<BR/>+ save(session) : str<BR/>+ is_expired(session) : bool</TD></TR></TABLE>>];
"AccessControl" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8EEEA"><B>AccessControl</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PERMISSIONS : dict  (Table 22)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ allowed(permission) : bool<BR/>+ require(permission, record)</TD></TR></TABLE>>];
