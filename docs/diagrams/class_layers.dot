"JsonRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8EEEA"><B>JsonRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _store : dict<BR/>+ settings : dict</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ all(collection) : list<BR/>+ get(collection, id)<BR/>+ find(collection, **criteria) : list<BR/>+ next_id(collection) : str<BR/>+ add(collection, entity)<BR/>+ save(collection)<BR/>+ backup_if_needed(today)<BR/>+ restore_backup(name)</TD></TR></TABLE>>];
